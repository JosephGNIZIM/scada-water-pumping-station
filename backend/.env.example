DATABASE_URL=sqlite:///path/to/database.db
JWT_SECRET=your_jwt_secret
MQTT_BROKER_URL=mqtt://your_mqtt_broker
MQTT_TOPIC=your_mqtt_topic
PUMP_DEFAULT_STATUS=off
SENSOR_DEFAULT_TYPE=temperature
ALARM_THRESHOLD=high

# Modbus TCP Configuration
# Set MODBUS_ENABLED=true when a PLC is reachable.
# Keep MODBUS_ENABLED=false to use realistic simulated telemetry for development.
MODBUS_ENABLED=false
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_POLL_INTERVAL_MS=2000
MODBUS_RECONNECT_DELAY_MS=5000

# Data Retention
DATA_RETENTION_DAYS=90
